    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length) {\n  throw new Error('No input data received.');\n}\n\nconst sql = String(items[0].json.query || '').trim();\n\nif (!sql) {\n  throw new Error('No SQL query was provided.');\n}\n\nconst normalized = sql\n  .replace(/--.*$/gm, '')\n  .replace(/\\/\\*[\\s\\S]*?\\*\\//g, '')\n  .trim()\n  .toUpperCase();\n\nif (!/^(SELECT|WITH)\\b/.test(normalized)) {\n  throw new Error(\n    'Rejected: only read-only SELECT/WITH queries are allowed.'\n  );\n}\n\nconst forbiddenKeywords = [\n  'INSERT',\n  'UPDATE',\n  'DELETE',\n  'DROP',\n  'ALTER',\n  'TRUNCATE',\n  'MERGE',\n  'CREATE',\n  'GRANT',\n  'REVOKE',\n  'CALL',\n  'EXEC',\n  'EXECUTE'\n];\n\nfor (const keyword of forbiddenKeywords) {\n  const pattern = new RegExp(`\\\\b${keyword}\\\\b`, 'i');\n\n  if (pattern.test(normalized)) {\n    throw new Error(`Rejected: forbidden SQL operation detected: ${keyword}`);\n  }\n}\n\nif (\n  !normalized.includes('HEALTHCARE_DB.CLEAN_SCHEMA') &&\n  !normalized.includes('CLEAN_SCHEMA.')\n) {\n  throw new Error(\n    'Rejected: query must access HEALTHCARE_DB.CLEAN_SCHEMA.'\n  );\n}\n\nreturn [\n  {\n    json: {\n      query: sql,\n      validation_status: 'PASSED',\n      validation_timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
